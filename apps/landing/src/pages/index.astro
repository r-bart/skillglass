---
import { getImage } from "astro:assets"
import brandIcon from "../assets/skillglass-icon.png"
import { publishedAssets, skillglassRelease } from "../data/release.js"
import "../styles/global.css"

type Language = "es" | "en"
type Props = { language?: Language }

const { language = "en" } = Astro.props as Props
const repositoryUrl = "https://github.com/r-bart/skillglass"
const releasesUrl = `${repositoryUrl}/releases`
const issuesUrl = `${repositoryUrl}/issues`
const installationUrl = `${repositoryUrl}/blob/main/docs/installation.md`
const iconSmall = await getImage({ src: brandIcon, width: 72, format: "webp" })
const availableAssets = publishedAssets(skillglassRelease)
const availableAssetIds = new Set(availableAssets.map(({ id }) => id))

const copy = {
  es: {
    nav: ["Cómo funciona", "Demostración", "Privacidad", "Preguntas"], download: "Ver descargas",
    hero: {
      kicker: "App local para skills de Codex",
      title: "Encuentra y edita tus skills en un solo lugar.",
      body: "Explora las carpetas que elijas, lee las instrucciones de cada skill y revisa los cambios antes de guardarlos. Funciona con skills de Codex y otras carpetas con archivos SKILL.md.",
      primary: "Ver descargas", secondary: "Ver el recorrido",
      privacy: "Sin cuenta ni telemetría. Tus archivos permanecen en tu equipo.",
    },
    how: { kicker: "Cómo funciona", title: "De tus carpetas a un inventario claro.", steps: [
      ["Elige dónde buscar", "Skillglass propone las ubicaciones habituales y te permite añadir otras. Solo escanea las carpetas que autorizas."],
      ["Encuentra una skill", "Busca por nombre, descripción o ruta. Ábrela para leer sus instrucciones y ver dónde está guardada."],
      ["Edita con control", "Revisa el diff antes de guardar. Después puedes deshacer el cambio desde el historial."],
    ] },
    features: { kicker: "Qué puedes hacer", title: "Las herramientas justas para trabajar con tus skills.", items: [
      ["Busca en tus carpetas", "Consulta skills de Codex y de otras carpetas que hayas añadido."],
      ["Encuentra nombres repetidos", "Si hay varias copias con el mismo nombre, Skillglass te muestra dónde está cada una."],
      ["Lee Markdown con claridad", "Títulos, listas, tablas, código y enlaces seguros se muestran sin ejecutar el contenido importado."],
      ["Detecta problemas", "Una skill incompleta o inválida sigue visible y te indica qué debes corregir."],
      ["Añade skills locales", "Instala una skill desde una carpeta o un archivo ZIP que ya esté en tu equipo."],
      ["Guarda y deshaz", "Revisa el cambio exacto antes de guardar y deshazlo mientras los archivos no hayan cambiado fuera de Skillglass."],
    ] },
    demo: {
      kicker: "Recorrido por la aplicación", title: "Encontrar, editar y deshacer en seis pasos.",
      body: "Capturas de la aplicación real con skills de ejemplo: desde la búsqueda hasta deshacer un cambio.",
      steps: [
        ["1. Encontrar", "Busca una skill dentro de las carpetas autorizadas."],
        ["2. Abrir", "Lee las instrucciones y comprueba su ubicación."],
        ["3. Editar", "Modifica SKILL.md dentro del editor local."],
        ["4. Revisar", "Comprueba el diff exacto antes de guardar."],
        ["5. Guardar", "Confirma el cambio y vuelve a abrir la skill."],
        ["6. Deshacer", "Recupera la versión anterior desde el historial."],
      ],
    },
    safety: { kicker: "Privacidad", title: "Tus archivos siguen bajo tu control.", body: "Skillglass funciona en tu equipo y solo escribe después de que confirmes un cambio.", items: [
      "Solo escanea las carpetas que autorizas.", "No ejecuta el contenido de una skill durante la inspección.",
      "No pide permisos de administrador ni root.", "No sincroniza archivos ni recopila telemetría de uso.",
    ] },
    release: {
      kicker: "Descarga", pendingTitle: `Skillglass ${skillglassRelease.version} estará disponible pronto.`,
      pendingBody: "Estamos terminando de comprobar los instaladores. En cuanto estén listos, podrás descargarlos aquí.",
      readyTitle: `Descarga Skillglass ${skillglassRelease.version}.`, assetCta: "Descargar", guide: "Instrucciones de instalación", releases: "Abrir GitHub Releases", targets: "Formatos previstos", checksums: "Ver checksums", statusPending: "Próximamente", statusVerified: "Verificado",
      signing: "Los instaladores aún no están firmados por un editor reconocido. Consulta las instrucciones para instalarlos en cada sistema.",
    },
    faq: { kicker: "Preguntas frecuentes", title: "Lo que conviene saber antes de empezar.", items: [
      ["¿Qué carpetas son compatibles?", "Skillglass reconoce ubicaciones de Codex y permite añadir carpetas que contengan SKILL.md. Solo muestra lo que has autorizado."],
      ["¿Mis skills salen de mi equipo?", "No. El índice y las copias necesarias para deshacer se guardan en tu equipo. No necesitas cuenta y Skillglass no recopila telemetría."],
      ["¿Cómo funcionan guardar y deshacer?", "Cada cambio se muestra en un diff antes de guardarlo. Puedes deshacerlo desde el historial mientras los archivos no hayan cambiado fuera de Skillglass."],
      ["¿Qué queda fuera de esta versión?", "Skillglass no activa, desactiva ni desinstala skills. Tampoco instala desde internet, sincroniza datos, genera contenido con IA ni actualiza la aplicación."],
    ] },
    closing: {
      title: "Una herramienta pequeña, hecha por Roberto.",
      body: "Creé Skillglass para consultar y editar mis propias skills desde una app local. La comparto con licencia Apache 2.0.",
      author: "Roberto en GitHub", issues: "Abrir GitHub Issues", source: "Ver el código en GitHub", footer: "Local · Sin cuenta · Sin telemetría",
    },
  },
  en: {
    nav: ["How it works", "Demo", "Privacy", "Questions"], download: "View downloads",
    hero: {
      kicker: "A local app for Codex skills",
      title: "Find and edit your skills in one place.",
      body: "Browse the folders you choose, read each skill’s instructions, and review changes before saving. It works with Codex skills and other folders containing SKILL.md files.",
      primary: "View downloads", secondary: "See the walkthrough",
      privacy: "No account or telemetry. Your files stay on your computer.",
    },
    how: { kicker: "How it works", title: "From your folders to a clear inventory.", steps: [
      ["Choose where to look", "Skillglass suggests the usual locations and lets you add others. It scans only the folders you approve."],
      ["Find a skill", "Search by name, description, or path. Open a skill to read its instructions and see where it is stored."],
      ["Edit with control", "Review the diff before saving. You can undo the change later from History."],
    ] },
    features: { kicker: "What you can do", title: "Just enough to work with your skills.", items: [
      ["Search your folders", "Browse Codex skills and other folders you have added."],
      ["Find duplicate names", "If several copies share a name, Skillglass shows you where each one is stored."],
      ["Read Markdown clearly", "Headings, lists, tables, code, and safe links render without executing imported content."],
      ["Spot problems", "An incomplete or invalid skill stays visible and tells you what to fix."],
      ["Add local skills", "Install a skill from a folder or ZIP file that is already on your computer."],
      ["Save and undo", "Review the exact change before saving and undo it while the files remain unchanged outside Skillglass."],
    ] },
    demo: {
      kicker: "App walkthrough", title: "Find, edit, and undo in six steps.",
      body: "Screenshots from the real app using example skills, from finding one to undoing a change.",
      steps: [
        ["1. Find", "Search for a skill inside your approved folders."], ["2. Open", "Read its instructions and check its location."],
        ["3. Edit", "Change SKILL.md in the local editor."], ["4. Review", "Inspect the exact diff before saving."],
        ["5. Save", "Confirm the change and open the skill again."], ["6. Undo", "Restore the previous version from History."],
      ],
    },
    safety: { kicker: "Privacy", title: "Your files remain under your control.", body: "Skillglass runs on your computer and writes only after you confirm a change.", items: [
      "It scans only the folders you approve.", "It never executes skill content during inspection.",
      "It does not request administrator or root privileges.", "It does not sync files or collect usage telemetry.",
    ] },
    release: {
      kicker: "Download", pendingTitle: `Skillglass ${skillglassRelease.version} is coming soon.`,
      pendingBody: "We're finishing the installer checks. Download links will appear here as soon as they're ready.",
      readyTitle: `Download Skillglass ${skillglassRelease.version}.`, assetCta: "Download", guide: "Installation guide", releases: "Open GitHub Releases", targets: "Planned formats", checksums: "View checksums", statusPending: "Coming soon", statusVerified: "Verified",
      signing: "The installers are not yet signed by a recognized publisher. See the installation guide for the steps on each operating system.",
    },
    faq: { kicker: "Frequently asked questions", title: "What to know before you start.", items: [
      ["Which folders are supported?", "Skillglass recognizes Codex locations and lets you add folders that contain SKILL.md files. It shows only what you approve."],
      ["Do my skills leave my computer?", "No. The index and the copies needed for undo stay on your computer. You do not need an account, and Skillglass collects no telemetry."],
      ["How do save and undo work?", "Every change appears as a diff before you save it. You can undo it from History while the files remain unchanged outside Skillglass."],
      ["What does this version leave out?", "Skillglass does not activate, deactivate, or uninstall skills. It also has no internet installs, sync, AI generation, or automatic app updates."],
    ] },
    closing: {
      title: "A small tool, built by Roberto.",
      body: "I built Skillglass to browse and edit my own skills from a local app. I’m sharing it under the Apache 2.0 license.",
      author: "Roberto on GitHub", issues: "Open GitHub Issues", source: "View source on GitHub", footer: "Local · No account · No telemetry",
    },
  },
} as const

const t = copy[language]
const metadata = {
  es: { title: "Encuentra y edita tus skills | Skillglass", description: "Consulta y edita skills de Codex y carpetas con SKILL.md desde una aplicación local. Revisa cada cambio antes de guardarlo.", locale: "es_ES", alternateLocale: "en_US", imageAlt: "Skillglass, una app local para encontrar y editar skills" },
  en: { title: "Find and edit your skills | Skillglass", description: "Browse and edit Codex skills and folders containing SKILL.md files in a local app. Review every change before saving.", locale: "en_US", alternateLocale: "es_ES", imageAlt: "Skillglass, a local app for finding and editing skills" },
} as const
const pageMetadata = metadata[language]
const siteUrl = Astro.site ?? new URL("https://skillglass.dev")
const canonicalUrl = new URL(language === "es" ? "/es/" : "/", siteUrl)
const alternateLanguage: Language = language === "es" ? "en" : "es"
const alternateLanguageUrl = alternateLanguage === "es" ? "/es/" : "/"
const alternateLanguageLabel = language === "es" ? "Cambiar a inglés" : "Switch to Spanish"
const productShot = `/demo/product-${language}.webp`
const demoFrames = t.demo.steps.map((step, index) => ({ alt: step[1], src: `/demo/${language}-${String(index + 1).padStart(2, "0")}.webp`, title: step[0] }))
const ogImageUrl = new URL("/og-image.png?v=3", siteUrl)
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "SoftwareApplication", "@id": `${siteUrl.origin}/#software`, name: "Skillglass", applicationCategory: "DeveloperApplication", operatingSystem: "macOS, Windows, Linux", softwareVersion: skillglassRelease.version, description: pageMetadata.description, url: canonicalUrl.href, image: ogImageUrl.href, license: "https://www.apache.org/licenses/LICENSE-2.0", codeRepository: repositoryUrl, ...(availableAssets.length > 0 ? { downloadUrl: releasesUrl } : {}) },
    { "@type": "FAQPage", "@id": `${canonicalUrl.href}#faq-schema`, mainEntity: t.faq.items.map(([name, answer]) => ({ "@type": "Question", name, acceptedAnswer: { "@type": "Answer", text: answer } })) },
  ],
}
---

<!doctype html>
<html lang={language} data-lang={language}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageMetadata.description} /><meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" /><meta name="theme-color" content="#0b0b0d" /><meta name="application-name" content="Skillglass" /><meta name="author" content="Roberto" />
    <meta property="og:title" content={pageMetadata.title} /><meta property="og:description" content={pageMetadata.description} /><meta property="og:type" content="website" /><meta property="og:site_name" content="Skillglass" /><meta property="og:url" content={canonicalUrl.href} /><meta property="og:locale" content={pageMetadata.locale} /><meta property="og:locale:alternate" content={pageMetadata.alternateLocale} /><meta property="og:image" content={ogImageUrl.href} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={pageMetadata.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={pageMetadata.title} /><meta name="twitter:description" content={pageMetadata.description} /><meta name="twitter:image" content={ogImageUrl.href} /><meta name="twitter:image:alt" content={pageMetadata.imageAlt} />
    <link rel="canonical" href={canonicalUrl.href} /><link rel="alternate" hreflang="en" href={new URL("/", siteUrl).href} /><link rel="alternate" hreflang="es" href={new URL("/es/", siteUrl).href} /><link rel="alternate" hreflang="x-default" href={new URL("/", siteUrl).href} /><link rel="preload" as="image" href={productShot} type="image/webp" /><link rel="icon" href="/favicon.png" type="image/png" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" /><link rel="manifest" href="/site.webmanifest" />
    <title>{pageMetadata.title}</title><script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>(() => { if (window.location.pathname !== "/") return; const storageKey = "skillglass-language"; let savedLanguage = null; try { savedLanguage = window.localStorage.getItem(storageKey) } catch {}; const preferences = navigator.languages?.length ? navigator.languages : [navigator.language]; const preferredLanguage = preferences.find((preference) => /^(?:es|en)(?:-|$)/i.test(preference)); const browserPrefersSpanish = preferredLanguage?.toLowerCase().startsWith("es") ?? false; if (savedLanguage !== "es" && (savedLanguage === "en" || !browserPrefersSpanish)) return; const destination = new URL("/es/", window.location.origin); destination.search = window.location.search; destination.hash = window.location.hash; window.location.replace(destination) })()</script>
  </head>
  <body>
    <a class="skip-link" href="#main">{language === "es" ? "Saltar al contenido" : "Skip to content"}</a>
    <header class="site-header"><a class="brand" href="#top" aria-label="Skillglass"><img src={iconSmall.src} width="26" height="26" alt="" /><span>Skillglass</span></a><nav aria-label={language === "es" ? "Navegación principal" : "Main navigation"}><a href="#how">{t.nav[0]}</a><a href="#demo">{t.nav[1]}</a><a href="#safety">{t.nav[2]}</a><a href="#faq">{t.nav[3]}</a></nav><div class="header-actions"><a class="language-switch" href={alternateLanguageUrl} lang={alternateLanguage} hreflang={alternateLanguage} data-language-target={alternateLanguage} aria-label={alternateLanguageLabel}><span>{alternateLanguage.toUpperCase()}</span></a><a class="button metal header-download" href="#download">{t.download}</a></div></header>
    <main id="main">
      <section class="hero" id="top"><div class="bloom bloom-violet" aria-hidden="true"></div><div class="bloom bloom-orange" aria-hidden="true"></div><div class="container hero-inner"><p class="kicker">{t.hero.kicker}</p><h1>{t.hero.title}</h1><p class="hero-body">{t.hero.body}</p><div class="cta-row"><span class="signature-shell"><a class="button metal signature" href="#download">{t.hero.primary}</a></span><a class="button quiet" href="#demo">{t.hero.secondary}</a></div><p class="privacy-copy">{t.hero.privacy}</p></div><div class="product-shot container"><div class="product-shot-crop"><img src={productShot} width="1600" height="1000" alt={language === "es" ? "Inventario de Skillglass en español con skills de ejemplo" : "Skillglass inventory in English with example skills"} loading="eager" fetchpriority="high" decoding="async" /></div></div></section>
      <section class="page-section" id="demo"><div class="container"><p class="kicker">{t.demo.kicker}</p><h2>{t.demo.title}</h2><p class="section-lead">{t.demo.body}</p><ol class="demo-sequence">{demoFrames.map((frame) => <li><img src={frame.src} width="1600" height="1000" alt={frame.alt} loading="lazy" decoding="async" /><div><h3>{frame.title}</h3><p>{frame.alt}</p></div></li>)}</ol></div></section>
      <section class="page-section" id="how"><div class="container"><p class="kicker">{t.how.kicker}</p><h2>{t.how.title}</h2><ol class="step-grid">{t.how.steps.map((step, index) => <li><span class="step-number">{index + 1}</span><h3>{step[0]}</h3><p>{step[1]}</p></li>)}</ol></div></section>
      <section class="page-section" id="features"><div class="container"><p class="kicker">{t.features.kicker}</p><h2>{t.features.title}</h2><div class="capability-grid">{t.features.items.map((item) => <article><h3>{item[0]}</h3><p>{item[1]}</p></article>)}</div></div></section>
      <section class="page-section" id="safety"><div class="container"><p class="kicker">{t.safety.kicker}</p><h2>{t.safety.title}</h2><p class="section-lead">{t.safety.body}</p><ul class="safety-grid">{t.safety.items.map((item) => <li><i class="status-dot"></i><span>{item}</span></li>)}</ul></div></section>
      <section class="page-section" id="download"><div class="container download-grid"><div class="download-card"><p class="kicker">{t.release.kicker}</p><h2 class="column-title">{availableAssets.length > 0 ? t.release.readyTitle : t.release.pendingTitle}</h2>{availableAssets.length > 0 ? <div class="release-actions">{availableAssets.map((asset) => <a class="button metal" href={asset.url}>{t.release.assetCta} {asset.platform} · {asset.architecture}</a>)}</div> : <p>{t.release.pendingBody}</p>}<aside class="unsigned-notice">{t.release.signing}</aside><div class="cta-row"><a class="button quiet" href={installationUrl}>{t.release.guide}</a><a class="button quiet" href={releasesUrl}>{t.release.releases}</a>{skillglassRelease.status === "published" ? <a class="button quiet" href={skillglassRelease.checksumsUrl}>{t.release.checksums}</a> : null}</div></div><div class="requirements-card"><p class="kicker">{t.release.targets}</p><h2 class="column-title">{skillglassRelease.tag}</h2><ul class="release-targets">{skillglassRelease.targets.map((target) => <li><span><strong>{target.platform}</strong><small>{target.architecture} · {target.package}</small></span><em>{availableAssetIds.has(target.id) ? t.release.statusVerified : t.release.statusPending}</em></li>)}</ul></div></div></section>
      <section class="page-section" id="faq"><div class="container"><p class="kicker">{t.faq.kicker}</p><h2>{t.faq.title}</h2><div class="faq-grid">{t.faq.items.map((item) => <article><h3>{item[0]}</h3><p>{item[1]}</p></article>)}</div></div></section>
      <section class="closing-section"><div class="container closing-card"><div class="closing-bloom" aria-hidden="true"></div><img src={iconSmall.src} width="72" height="72" alt="" loading="lazy" /><h2>{t.closing.title}</h2><p>{t.closing.body}</p><p class="author-line"><a href="https://github.com/r-bart">{t.closing.author} ↗</a></p><div class="cta-row"><a class="button metal" href={issuesUrl}>{t.closing.issues}</a><a class="button quiet" href={repositoryUrl}>{t.closing.source}</a></div></div></section>
    </main>
    <footer><div class="container footer-inner"><a class="brand footer-brand" href="#top"><img src={iconSmall.src} width="20" height="20" alt="" /><span>Skillglass {skillglassRelease.status === "pending" ? `${skillglassRelease.tag} · ${t.release.statusPending}` : skillglassRelease.tag}</span></a><span class="footer-copy">{t.closing.footer}</span><div class="footer-links"><a href="https://github.com/r-bart">{language === "es" ? "Roberto en GitHub" : "Roberto on GitHub"} ↗</a><a href={issuesUrl}>GitHub Issues ↗</a></div></div></footer>
    <script>const languageSwitch = document.querySelector<HTMLAnchorElement>("[data-language-target]"); languageSwitch?.addEventListener("click", () => { try { window.localStorage.setItem("skillglass-language", languageSwitch.dataset.languageTarget ?? "en") } catch {} }); const siteHeader = document.querySelector<HTMLElement>(".site-header"); let headerFrame = 0; function updateHeaderSurface() { headerFrame = 0; siteHeader?.toggleAttribute("data-scrolled", window.scrollY > 12) }; updateHeaderSurface(); window.addEventListener("scroll", () => { if (headerFrame) return; headerFrame = requestAnimationFrame(updateHeaderSurface) }, { passive: true })</script>
  </body>
</html>
