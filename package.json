{
  "name": "skillglass",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Open-source desktop inventory and safe installer/updater for agent skills",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": "24.19.x",
    "pnpm": "11.5.x"
  },
  "scripts": {
    "dev": "pnpm --filter @forge/desktop start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "package": "pnpm --filter @forge/desktop package",
    "make": "pnpm --filter @forge/desktop make"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "3.2.7"
  }
}
